# Copy to setup.env, edit, then run scripts/setup.sh render and scripts/setup.sh all.
# Bash assignments: single-quote secrets containing spaces, dollars or punctuation.
# Generate unique secrets; Homarr key: openssl rand -hex 32
SETUP_USER=your-linux-user
DATA_ROOT=/data
# Fail if the data disk is unmounted; false deliberately stores data on the OS disk.
REQUIRE_DATA_MOUNT=true
HOMELAB_ROOT=/home/your-linux-user/homelab
LAN_IP=127.0.0.1
NETWORK_INTERFACE=
DOCKER_ROOT=/data/docker
HOMARR_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JOPLIN_BASE_URL=http://joplin.home
JOPLIN_DB_PASSWORD=replace-with-a-long-random-password
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=replace-with-a-long-random-password
VAULTWARDEN_ADMIN_TOKEN=replace-with-a-long-random-token
VAULTWARDEN_DOMAIN=http://localhost:2852
VAULTWARDEN_SIGNUPS_ALLOWED=false
TAILSCALE_DNS_NAME=
TZ=Asia/Kolkata
SAMBA_PASSWORD=replace-with-a-long-random-password
BORG_PASSPHRASE=replace-with-a-long-random-passphrase
ENABLE_BACKUPS=false
# Optional: BORG_REPO=/mnt/separate-backup-disk/sisyphus-borg
SMART_DEVICE=
ENABLE_STORAGE_SETUP=false
DATA_DISK=/dev/disk/by-id/replace-with-data-disk
ALLOW_DISK_ERASE=false
ENABLE_DESKTOP=false
ENABLE_AUTOLOGIN=false
ENABLE_UFW=false
SSH_PORT=22
ENABLE_TAILSCALE=false
ENABLE_VAULTWARDEN_TAILSCALE_SERVE=false
ENABLE_SURICATA=false
DISABLE_SLEEP=false
ENABLE_MONITORING=true
ENABLE_MUSIC=true
ENABLE_JELLYFIN=true
JELLYFIN_HW_ACCEL=false
